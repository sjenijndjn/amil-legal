# --- FRONTEND (Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AMIL

# --- BACKEND (Railway) ---
ENVIRONMENT=development
APP_BRAND_NAME=AMIL
OWNER_DEFAULT_NAME=Amil Bhatt
OWNER_DEFAULT_EMAIL=amil@amillegal.in

# PostgreSQL (Railway supplies DATABASE_URL; normalized automatically)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/amil_legal

# Google Gemini API (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Security & JWT
JWT_SECRET=replace_with_64_byte_cryptographic_random_hex_secret_key_for_prod
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origin
FRONTEND_URL=http://localhost:3000

# Private S3-Compatible Object Storage (Documents)
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_ACCESS_KEY=your_storage_access_key_here
STORAGE_SECRET_KEY=your_storage_secret_key_here
STORAGE_BUCKET_NAME=amil-private-documents
